    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.3",
    "postcss": "^8.4.38",
    "prisma": "^5.14.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "wait-on": "^7.2.0"
  },
  "allowScripts": {
    "keytar@7.9.0": true,
    "electron@30.5.1": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  }
}
